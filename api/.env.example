# Local API configuration. Inject real secrets through a protected
# deployment channel; do not commit api/.env or put server values in VITE_*.
NODE_ENV=development
SUPABASE_URL=https://project.supabase.co
# Use separate login roles granted app_runtime and gateway_runtime, respectively.
# Production: Supabase transaction pooling with sslmode=verify-full on both URLs.
DATABASE_URL=postgresql://api_login:REPLACE_ME@127.0.0.1:5432/postgres
AUTH_DATABASE_URL=postgresql://auth_login:REPLACE_ME@127.0.0.1:5432/postgres
ORIGIN_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
PUBLIC_ORIGIN=http://localhost:5173
# npm run setup:env generates this once in api/.env and preserves existing keys.
# All API instances must receive the same persisted value; never regenerate at startup.
COOKIE_KEYS=REPLACE_WITH_A_JSON_KEY_RING
SUPABASE_PUBLISHABLE_KEY=REPLACE_ME
SUPABASE_JWT_AUDIENCE=authenticated
DISCORD_CLIENT_ID=REPLACE_ME
DISCORD_CLIENT_SECRET=REPLACE_ME
DISCORD_GUILD_ID=REPLACE_ME
# Optional, server-only values:
# SUPABASE_SECRET_KEY=REPLACE_ME
# DISCORD_TRANSFER_WEBHOOK=https://discord.com/api/webhooks/REPLACE_ME
# SUPABASE_SECRET_KEY is used only for trusted original-IP forwarding.
