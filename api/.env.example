# Local API using hosted Supabase Auth and Postgres.
# Fill in your hosted project settings, then run pnpm run setup:env once.
# Never commit api/.env or prefix server secrets with VITE_.
NODE_ENV=development
# Exact browser origin, without a path or trailing slash. Open Compose at localhost, not 127.0.0.1.
PUBLIC_ORIGIN=http://localhost:5173
# Copy the database connection from Supabase's Connect dialog; keep certificate verification enabled.
# Download the server root certificate from Supabase Database Settings to api/prod-ca-2021.crt.
# Native API and Compose resolve this relative certificate path from their API working directory.
DATABASE_URL=postgresql://postgres:REPLACE_WITH_DATABASE_PASSWORD@db.PROJECT.supabase.co:5432/postgres?sslmode=verify-full&sslrootcert=prod-ca-2021.crt
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://PROJECT.supabase.co/auth/v1/.well-known/jwks.json

# Hosted Discord OAuth is configured in Supabase Dashboard.
# The API needs the same Discord application to refresh provider tokens and check guild membership.
DISCORD_CLIENT_ID=REPLACE_WITH_DISCORD_CLIENT_ID
DISCORD_CLIENT_SECRET=REPLACE_WITH_DISCORD_CLIENT_SECRET
DISCORD_GUILD_ID=REPLACE_WITH_DISCORD_GUILD_ID

# API cookie encryption and proxy authentication remain required with hosted Auth.
# Setup generates these once and preserves existing values; ORIGIN_SECRET must match web/.env.
COOKIE_KEYS=
ORIGIN_SECRET=

# Production values are injected by GitHub Actions; see README.md for deployment.
# DISCORD_TRANSFER_WEBHOOK=
