# Local defaults for the API and Compose's self-hosted Supabase Auth.
# Run pnpm run setup:env once. Hosted Supabase settings are described below.
# Never commit api/.env or prefix server secrets with VITE_.
NODE_ENV=development
# Exact browser origin, without a path or trailing slash. Open Compose at localhost, not 127.0.0.1.
PUBLIC_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://napl_local:napl_local_only@127.0.0.1:54322/napl_local
# Hosted Supabase: https://PROJECT.supabase.co and its /auth/v1/.well-known/jwks.json endpoint.
SUPABASE_URL=http://localhost:54321
SUPABASE_PUBLISHABLE_KEY=local-development
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=http://localhost:54321/.well-known/jwks.json

# Compose-only switch for local GoTrue; hosted Discord OAuth is configured in Supabase Dashboard.
# For local sign-in, register http://localhost:54321/callback in the Discord application.
DISCORD_ENABLED=false
# The API also needs these to refresh Discord provider tokens and check guild membership.
# Use the same Discord application configured in Supabase Auth, including when hosted.
DISCORD_CLIENT_ID=0
DISCORD_CLIENT_SECRET=local-not-configured
DISCORD_GUILD_ID=0

# Setup generates these once and preserves existing values.
COOKIE_KEYS=
ORIGIN_SECRET=
# Local GoTrue signing keys only; do not copy these into hosted Supabase or Lambda settings.
GOTRUE_JWT_SECRET=
GOTRUE_JWT_KEYS=

# Production values are injected by GitHub Actions; see README.md for deployment.
# DISCORD_TRANSFER_WEBHOOK=
