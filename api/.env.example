# Local API using hosted Supabase Auth and PostgreSQL. Never commit api/.env.
NODE_ENV=development
# Exact browser origin, without a path or trailing slash. Open Compose at localhost.
PUBLIC_ORIGIN=http://localhost:5173
# Download the Supabase database CA to api/prod-ca-2021.crt.
DATABASE_URL=postgresql://postgres:REPLACE_WITH_DATABASE_PASSWORD@db.PROJECT.supabase.co:5432/postgres?sslmode=verify-full&sslrootcert=prod-ca-2021.crt
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_SUPABASE_PUBLISHABLE_KEY
SUPABASE_JWKS_URL=https://PROJECT.supabase.co/auth/v1/.well-known/jwks.json
# Discord OAuth credentials are configured only in Supabase Dashboard.
# Optional independent roster notice webhook:
# DISCORD_TRANSFER_WEBHOOK=
