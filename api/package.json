{
  "name": "@napl/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup:env": "node --import tsx scripts/setup-env.mjs",
    "env:sam": "node --import tsx scripts/sam-env.mjs",
    "dev": "node --env-file-if-exists=.env --import tsx --watch dev.ts",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --import ../web/test/setup.mjs --test --test-concurrency=1 test/plugins/*.test.ts test/routes/*.test.ts test/integration/*.test.ts",
    "prisma:generate": "prisma generate",
    "test:db": "bash test/integration/run.sh --api",
    "test:package": "node --test test/integration/package.test.mjs"
  },
  "dependencies": {
    "@apollo/server": "5.5.1",
    "@fastify/aws-lambda": "6.4.2",
    "@fastify/cors": "11.3.1",
    "@napl/contracts": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@supabase/storage-js": "2.118.0",
    "fastify": "^5.0.0",
    "fastify-plugin": "5.1.0",
    "graphql": "16.14.2",
    "ipaddr.js": "^2.2.0",
    "jose": "^6.0.0",
    "pg": "^8.16.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@apollo/client": "4.3.3",
    "@types/aws-lambda": "8.10.161",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "esbuild": "0.25.12",
    "prisma": "7.10.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "yaml": "^2.9.1"
  }
}
