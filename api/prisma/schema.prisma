// SQL migrations in supabase own the database schema. Prisma models only
// describe tables used by typed client methods; raw SQL needs no model.
generator client {
  provider = "prisma-client"
  output = "../generated/prisma"
}
datasource db {
  provider = "postgresql"
  schemas = ["asl", "auth_gateway"]
}
model Membership {
  user_id String @id @db.Uuid
  discord_user_id String
  eligible Boolean
  valid_until DateTime @db.Timestamptz
  checked_at DateTime @default(now()) @db.Timestamptz
  @@map("memberships")
  @@schema("auth_gateway")
}

model Account {
  id String @id @db.Uuid
  username String
  username_lower String @unique @default(dbgenerated())
  position String @default("CM")
  team_id String?
  image_url String?
  pending_image_url String?
  email String?
  country String?
  stats Json @default("{}")
  matches Json @default("[]")
  awards Json @default("[]")
  championships Json @default("[]")
  totw_until DateTime? @db.Timestamptz
  cheater Boolean @default(false)
  created_at DateTime @db.Timestamptz @default(now())
  strikers_id String?
  steam_url String?
  @@map("accounts")
  @@schema("asl")
}

model Team {
  id String @id
  name String
  tag String
  color String?
  description String?
  owner_account_id String @db.Uuid
  totw Boolean @default(false)
  totw_set_at DateTime? @db.Timestamptz
  status String @default("pending")
  logo_url String?
  created_at DateTime @db.Timestamptz @default(now())
  reviewed_at DateTime? @db.Timestamptz
  reviewed_by String?
  reviewed_by_account_id String? @db.Uuid
  rejection_reason String?
  lineup Json @default("{}")
  formation String @default("2-1-2")
  @@map("teams")
  @@schema("asl")
}

model TeamJoinRequest {
  id String @id @db.Uuid @default(dbgenerated("gen_random_uuid()"))
  team_id String
  account_id String @db.Uuid
  status String @default("pending")
  created_at DateTime @db.Timestamptz @default(now())
  reviewed_at DateTime? @db.Timestamptz
  reviewed_by_account_id String? @db.Uuid
  review_note String?
  details Json @default("{}")
  @@map("team_join_requests")
  @@schema("asl")
}

model Season {
  id String @id
  @@map("seasons")
  @@schema("asl")
}

model TeamSeason {
  team_id String
  season_id String
  @@id([team_id, season_id])
  @@map("team_seasons")
  @@schema("asl")
}

model Article {
  id String @id
  slug String @unique
  title String
  cover_image_url String?
  author String
  body String
  excerpt String?
  published_at DateTime @db.Timestamptz @default(now())
  updated_at DateTime @db.Timestamptz @default(now())
  @@map("articles")
  @@schema("asl")
}

model RuleSection {
  id String @id
  title String
  body String @default("")
  sort_order Int @default(0)
  created_at DateTime @db.Timestamptz @default(now())
  updated_at DateTime @db.Timestamptz @default(now())
  @@map("rules_sections")
  @@schema("asl")
}

model Setting {
  key String @id
  value String?
  @@map("settings")
  @@schema("asl")
}

model ScheduledMatch {
  id String @id
  season_id String
  week Int
  home_team_id String
  away_team_id String
  scheduled_date DateTime? @db.Timestamptz
  stream_url String?
  match_type String @default("regular")
  playoff_round String?
  status String @default("scheduled")
  home_score Int?
  away_score Int?
  linked_match_id String?
  notes String?
  created_at DateTime @db.Timestamptz @default(now())
  updated_at DateTime @db.Timestamptz @default(now())
  @@map("scheduled_matches")
  @@schema("asl")
}

model Submission {
  id String @id
  status String @default("pending")
  submitted_by String
  submitted_by_account_id String? @db.Uuid
  submitted_at DateTime @db.Timestamptz @default(now())
  reviewed_by String?
  reviewed_by_account_id String? @db.Uuid
  reviewed_at DateTime? @db.Timestamptz
  rejection_reason String?
  match_info Json
  player_stats Json @default("[]")
  edits Json @default("[]")
  @@map("submissions")
  @@schema("asl")
}

model News {
  id String @id
  type String
  title String?
  body String?
  pinned Boolean @default(false)
  home_team_id String?
  away_team_id String?
  home_score Int?
  away_score Int?
  event_date DateTime? @db.Timestamptz
  notes String?
  author String?
  created_at DateTime @db.Timestamptz @default(now())
  auto_from_submission String?
  @@map("news")
  @@schema("asl")
}

model PositionChangeRequest {
  id String @id @db.Uuid @default(dbgenerated("gen_random_uuid()"))
  account_id String @db.Uuid
  username String
  from_pos String
  to_pos String
  reason String? @default("")
  status String @default("pending")
  reviewed_by String?
  reviewed_by_account_id String? @db.Uuid
  reviewed_at DateTime? @db.Timestamptz
  review_note String? @default("")
  created_at DateTime @db.Timestamptz @default(now())
  @@map("position_change_requests")
  @@schema("asl")
}

model TotwVotingPeriod {
  id String @id @db.Uuid @default(dbgenerated("gen_random_uuid()"))
  opens_at DateTime @db.Timestamptz @default(now())
  closes_at DateTime @db.Timestamptz
  status String @default("open")
  created_by String
  created_by_account_id String? @db.Uuid
  created_at DateTime @db.Timestamptz @default(now())
  resolved_at DateTime? @db.Timestamptz
  @@map("totw_voting_periods")
  @@schema("asl")
}

model TotwCandidate {
  period_id String @db.Uuid
  account_id String @db.Uuid
  position String
  details Json @default("{}")
  @@id([period_id, account_id, position])
  @@map("totw_candidates")
  @@schema("asl")
}

model TotwWinner {
  period_id String @db.Uuid
  account_id String @db.Uuid
  position String
  details Json @default("{}")
  @@id([period_id, account_id, position])
  @@map("totw_winners")
  @@schema("asl")
}

model TotwVote {
  id String @id @db.Uuid @default(dbgenerated("gen_random_uuid()"))
  period_id String @db.Uuid
  voter_account_id String @db.Uuid
  position String
  voted_for_account_id String @db.Uuid
  voted_at DateTime @db.Timestamptz @default(now())
  @@unique([period_id, voter_account_id, position])
  @@map("totw_votes")
  @@schema("asl")
}

model Transfer {
  id String @id
  season_id String
  player_account_id String @db.Uuid
  player_username_snapshot String
  from_team_id String?
  to_team_id String?
  kind String
  window_type String?
  created_at DateTime @db.Timestamptz @default(now())
  created_by String?
  created_by_account_id String? @db.Uuid
  @@map("transfers")
  @@schema("asl")
}

model UserRole {
  user_id String @db.Uuid
  role String
  @@id([user_id, role])
  @@map("user_roles")
  @@schema("auth_gateway")
}
