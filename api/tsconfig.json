{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "..",
    "sourceMap": true,
    "esModuleInterop": true,
    "lib": [
      "ES2023"
    ]
  },
  "include": [
    "routes",
    "plugins",
    "app.ts",
    "lambda.ts",
    "../pkgs/contracts/src",
    "dev.ts"
  ],
  "exclude": [
    "test"
  ]
}
