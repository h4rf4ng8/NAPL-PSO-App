{
  "name": "napl",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "10.15.1"
  },
  "scripts": {
    "setup:env": "pnpm --filter @napl/api run setup:env",
    "predev": "pnpm --filter @napl/contracts run build",
    "dev": "pnpm --filter @napl/web run dev",
    "generate": "pnpm run prisma:generate && pnpm run gql:generate",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "pretest": "pnpm --filter @napl/contracts run build",
    "test": "pnpm -r run test",
    "test:integration": "bash api/test/integration/run.sh",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "check": "pnpm run prisma:generate && pnpm run gql:check && pnpm run typecheck && pnpm run lint && pnpm test && pnpm run build",
    "gql:generate": "pnpm --filter @napl/web run gql:generate",
    "gql:check": "pnpm --filter @napl/web run gql:check",
    "prisma:generate": "pnpm --filter @napl/api run prisma:generate",
    "dev:api": "pnpm --filter @napl/api run dev",
    "env:sam": "pnpm --filter @napl/api run env:sam",
    "test:sam": "NAPL_SAM_TEST=1 bash api/test/integration/run.sh",
    "test:load": "node --import tsx api/test/load/run-staging.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "eslint-plugin-unicorn": "78.0.0",
    "globals": "17.13.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  }
}
