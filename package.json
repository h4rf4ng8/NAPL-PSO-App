{
  "name": "napl",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "workspaces": [
    "web",
    "api",
    "pkgs/*"
  ],
  "scripts": {
    "setup:env": "npm run setup:env -w @napl/api",
    "predev": "npm run build -w @napl/contracts",
    "dev": "npm run dev -w @napl/web",
    "generate": "npm run prisma:generate && npm run gql:generate",
    "build": "npm run build -w @napl/contracts && npm run build -w @napl/api && npm run build -w @napl/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "pretest": "npm run build -w @napl/contracts",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "bash api/test/integration/run.sh",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "check": "npm run prisma:generate && npm run gql:check && npm run typecheck && npm run lint && npm test && npm run build",
    "gql:generate": "npm run gql:generate -w @napl/web",
    "gql:check": "npm run gql:check -w @napl/web",
    "prisma:generate": "npm run prisma:generate -w @napl/api",
    "dev:api": "npm run dev -w @napl/api",
    "env:sam": "npm run env:sam -w @napl/api",
    "test:sam": "NAPL_SAM_TEST=1 bash api/test/integration/run.sh",
    "test:load": "node --import tsx api/test/load/run-staging.mjs"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.6"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "eslint-plugin-unicorn": "78.0.0",
    "globals": "17.13.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  }
}
