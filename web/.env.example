# Local development. Run pnpm run setup:env once.
# Vite forwards /api and /auth here; Compose supplies its container address.
LOCAL_API_URL=http://127.0.0.1:3000

# Required locally and in production; at least 32 characters, matching the API's ORIGIN_SECRET.
# Setup initializes matching local values in api/.env and web/.env.
ORIGIN_SECRET=

# Production: set these in Vercel's project environment, plus ORIGIN_SECRET above.
# API_URL is the root Lambda Function URL from the SAM FunctionUrl output.
# API_URL=https://FUNCTION_ID.lambda-url.us-east-2.on.aws/
# AWS_ROLE_ARN comes from the SAM VercelInvokeRoleArn output.
# AWS_ROLE_ARN=arn:aws:iam::ACCOUNT_ID:role/VERCEL_INVOKE_ROLE
# AWS_REGION must match the Lambda URL's region.
# AWS_REGION=us-east-2

# These settings are used by the server proxy. Do not prefix them with VITE_.
