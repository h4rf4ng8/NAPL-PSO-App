# Server-only Vite proxy settings; never use VITE_ for secrets.
# Set the same random ORIGIN_SECRET as api/.env (at least 32 characters).
ORIGIN_SECRET=REPLACE_WITH_THE_API_ORIGIN_SECRET
# Vercel production server-only settings (never prefix these with VITE_).
API_URL=https://REPLACE_WITH_FUNCTION_URL
AWS_ROLE_ARN=arn:aws:iam::123456789012:role/REPLACE_WITH_VERCEL_INVOKE_ROLE
AWS_REGION=us-west-2
# Local-only API target for the Vite dev server.
LOCAL_API_URL=http://127.0.0.1:3000
# Browser requests remain relative /api/* and /auth/*.
