# Public browser configuration, read by Vite at startup/build time.
# Local browser calls the loopback adapter directly; never use a container hostname.
VITE_API_URL=http://localhost:3000
# Production: use the deployed Lambda FunctionUrl output (HTTPS).
VITE_SUPABASE_URL=https://PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_SUPABASE_PUBLISHABLE_KEY
# Never put database passwords, Supabase secret keys, or Discord credentials here.
