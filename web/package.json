    "@playwright/test": "1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/react-test-renderer": "18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.4.21",
