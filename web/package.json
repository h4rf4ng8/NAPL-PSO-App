{
  "name": "@napl/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "gql:generate": "node --import tsx scripts/codegen.ts",
    "gql:check": "node --import tsx scripts/codegen.ts --check",
    "pregql:generate": "npm run build -w @napl/contracts",
    "pregql:check": "npm run build -w @napl/contracts"
  },
  "dependencies": {
    "@apollo/client": "4.3.3",
    "@napl/contracts": "*",
    "graphql": "16.14.2",
    "lucide-react": "0.383.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "rxjs": "7.8.2",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@graphql-codegen/core": "6.2.2",
    "@graphql-codegen/typed-document-node": "7.2.0",
    "@graphql-codegen/typescript-operations": "6.1.10",
    "@graphql-typed-document-node/core": "3.2.0",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.4.21",
    "esbuild": "0.25.12",
    "postcss": "8.5.30",
    "tailwindcss": "3.4.19",
    "vite": "6.4.4"
  }
}
