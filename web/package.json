{
  "name": "@napl/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && pnpm run build:proxy",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "gql:generate": "node --import tsx scripts/codegen.ts",
    "gql:check": "node --import tsx scripts/codegen.ts --check",
    "pregql:generate": "pnpm --filter @napl/contracts run build",
    "pregql:check": "pnpm --filter @napl/contracts run build",
    "build:proxy": "node scripts/build-proxy.mjs"
  },
  "dependencies": {
    "@apollo/client": "4.3.3",
    "@aws-crypto/sha256-js": "5.2.0",
    "@napl/contracts": "workspace:*",
    "@smithy/protocol-http": "5.6.2",
    "@smithy/signature-v4": "5.7.4",
    "@vercel/oidc-aws-credentials-provider": "3.3.13",
    "graphql": "16.14.2",
    "lucide-react": "0.383.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@graphql-codegen/core": "6.2.2",
    "@graphql-codegen/typed-document-node": "7.2.0",
    "@graphql-codegen/typescript-operations": "6.1.10",
    "@graphql-typed-document-node/core": "3.2.0",
    "@types/node": "^24.19.2",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.4.21",
    "esbuild": "0.25.12",
    "postcss": "8.5.30",
    "tailwindcss": "3.4.19",
    "vite": "6.4.4"
  }
}
