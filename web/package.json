{
  "name": "@napl/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "test": "node --import ./test/setup.mjs --import tsx --test test/*.test.ts",
    "gql:generate": "node --import tsx scripts/codegen.ts",
    "gql:check": "node --import tsx scripts/codegen.ts --check",
    "pregql:generate": "pnpm --filter @napl/contracts run build",
    "pregql:check": "pnpm --filter @napl/contracts run build"
  },
  "dependencies": {
    "@apollo/client": "4.3.3",
    "@napl/contracts": "workspace:*",
    "graphql": "16.14.2",
    "lucide-react": "0.383.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "rxjs": "7.8.2",
    "zod": "4.6.7",
    "@supabase/supabase-js": "2.118.0"
  },
  "devDependencies": {
    "@graphql-codegen/core": "6.2.2",
    "@graphql-codegen/typed-document-node": "7.2.0",
    "@graphql-codegen/typescript-operations": "6.1.10",
    "@graphql-typed-document-node/core": "3.2.0",
    "@types/node": "^24.19.2",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/react-test-renderer": "18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.4.21",
    "postcss": "8.5.30",
    "react-test-renderer": "18.3.1",
    "tailwindcss": "3.4.19",
    "vite": "6.4.4"
  }
}
