{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "buildCommand": "pnpm --filter @napl/contracts run build && pnpm --filter @napl/web run build",
  "outputDirectory": "dist"
}
