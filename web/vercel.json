{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "^/(api|auth)(/.*)?$",
      "dest": "/api/proxy",
      "headers": {
        "cache-control": "no-store",
        "x-vercel-enable-rewrite-caching": "0"
      }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "buildCommand": "pnpm --filter @napl/contracts run build && pnpm --filter @napl/web run build",
  "outputDirectory": "dist"
}
